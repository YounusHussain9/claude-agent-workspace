# Copy to .secrets/tokens.env and fill with READ-ONLY tokens from the approver.
# Claude cannot read this folder (blocked by settings.json and bash-guard.sh); bin/api-get.js loads it itself.
# Format: <SERVICE>_<ENV>_BASE and <SERVICE>_<ENV>_TOKEN. SERVICE matches the "API service key" column in workspace.md.

SHOP_STAGING_BASE=https://staging.example.com/api
SHOP_STAGING_TOKEN=
SHOP_PROD_BASE=https://example.com/api
SHOP_PROD_TOKEN=

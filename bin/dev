#!/usr/bin/env bash
# Run workspace repos with one command. Each repo is a profile in docker/compose.yml.
#   bin/dev up                     every repo (Docker)
#   bin/dev up shop-web shop-api   only these (Docker)
#   bin/dev down                   stop everything (Docker)
#   bin/dev logs shop-web          follow one repo's logs (Docker)
#   bin/dev test shop-api          run that repo's test command from workspace.md (native or Docker)
#   bin/dev ps                     what is running (Docker)
# DRY_RUN=1 bin/dev test <repo>    print what would run, run nothing
set -euo pipefail

WORK="$(cd "$(dirname "$0")/.." && pwd)"
COMPOSE=(docker compose -f "$WORK/docker/compose.yml" --project-directory "$WORK/docker")

need_docker() {
  command -v docker >/dev/null || { echo "Docker is not installed. Run the app natively, or install Docker: https://docs.docker.com/get-docker/"; exit 1; }
  [ -f "$WORK/docker/compose.yml" ] || { echo "Copy docker/compose.example.yml to docker/compose.yml and add your repos."; exit 1; }
}

# Reads only the "## Test commands" section of workspace.md: | repo | `command` | native|docker |
test_row() {
  awk '/^## /{ on = ($0 ~ /^## Test commands/) } on' "$WORK/workspace.md" \
    | grep -E "^\|[[:space:]]*$1([[:space:]]+\(example\))?[[:space:]]*\|" | head -1
}

cmd="${1:-help}"; shift || true
case "$cmd" in
  up|down|logs|ps) need_docker ;;
esac
profiles=()
if [ $# -eq 0 ]; then profiles=(--profile all); else for r in "$@"; do profiles+=(--profile "$r"); done; fi

case "$cmd" in
  up)   "${COMPOSE[@]}" "${profiles[@]}" up -d ;;
  down) "${COMPOSE[@]}" --profile all down ;;
  logs) r="${1:?bin/dev logs <repo>}"; "${COMPOSE[@]}" --profile "$r" logs -f "$r" ;;
  ps)   "${COMPOSE[@]}" --profile all ps ;;
  test)
    r="${1:?bin/dev test <repo>}"
    row="$(test_row "$r" || true)"
    [ -n "$row" ] || { echo "No row for '$r' in the Test commands table of workspace.md. Add: | $r | \`npm test\` | native |"; exit 1; }
    test_cmd="$(printf '%s' "$row" | awk -F'|' '{print $3}' | sed -E 's/^[[:space:]]*`?//; s/`?[[:space:]]*$//')"
    where="$(printf '%s' "$row" | awk -F'|' '{print $4}' | tr -d ' ')"
    if [ "$where" = "docker" ]; then
      echo "→ docker: $r: $test_cmd"
      [ "${DRY_RUN:-}" = 1 ] && exit 0
      need_docker
      "${COMPOSE[@]}" --profile "$r" exec "$r" sh -c "$test_cmd"
    else
      echo "→ native: $WORK/$r: $test_cmd"
      [ "${DRY_RUN:-}" = 1 ] && exit 0
      [ -d "$WORK/$r" ] || { echo "No folder $WORK/$r. Link the repo first: ln -s <path> $WORK/$r"; exit 1; }
      (cd "$WORK/$r" && sh -c "$test_cmd")
    fi
    ;;
  *) sed -n '2,9p' "$0" ;;
esac
